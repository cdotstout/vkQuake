{
    include: [ "//src/lib/vulkan/swapchain/VkLayer_image_pipe_swapchain.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/vkquake",
        args: [
            "-basedir",
            "/pkg/data",
            "+timedemo", "demo1.dem",
        ]
    },
    capabilities: [
        {
            protocol: [ "fuchsia.ui.app.ViewProvider" ],
        },
    ],
    expose: [
        {
            protocol: [ "fuchsia.ui.app.ViewProvider" ],
            from: "self",
            to: "parent",
        },
    ],
}
